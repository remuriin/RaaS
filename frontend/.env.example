# The Firebase web app's public identifiers. They ship inside the built app, so they are not secrets,
# but they are kept out of git anyway. Copy this file to .env and fill in the values printed by:
#
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project rag-service-remuriin
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
